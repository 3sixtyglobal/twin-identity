{
	"name": "@twin.org/identity-connector-iota",
	"version": "0.0.3-next.18",
	"description": "Connector for running identity and DID workflows against IOTA network infrastructure.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/identity.git",
		"directory": "packages/identity-connector-iota"
	},
	"author": "martyn.janes@iota.org",
	"contributors": [
		"cornel.filip@iota.org",
		"adrian.sanchez.sequeira@iota.org"
	],
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run test:build"
	},
	"dependencies": {
		"@iota/identity-wasm": "1.9.2-beta.1",
		"@iota/iota-sdk": "1.11.0",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/dlt-iota": "next",
		"@twin.org/entity": "next",
		"@twin.org/identity-models": "0.0.3-next.18",
		"@twin.org/nameof": "next",
		"@twin.org/standards-w3c-did": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-models": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/wallet-connector-iota": "next",
		"@vitest/coverage-v8": "4.1.0",
		"copyfiles": "2.4.1",
		"dotenv": "17.3.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "5.9.3",
		"vitest": "4.1.0"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"identity",
		"did",
		"credentials",
		"authentication",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/identity/issues"
	},
	"homepage": "https://twindev.org"
}
