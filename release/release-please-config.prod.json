{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"last-release-sha": "901561bafb08385876fa17312a2eedc1539589a5",
	"packages": {
		"packages/identity-models": {
			"package-name": "identity-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/identity-connector-entity-storage": {
			"package-name": "identity-connector-entity-storage",
			"changelog-path": "docs/changelog.md"
		},
		"packages/identity-service": {
			"package-name": "identity-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/identity-rest-client": {
			"package-name": "identity-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"packages/identity-connector-iota": {
			"package-name": "identity-connector-iota",
			"changelog-path": "docs/changelog.md"
		},
		"packages/identity-connector-universal": {
			"package-name": "identity-connector-universal",
			"changelog-path": "docs/changelog.md"
		},
		"apps/identity-cli": {
			"package-name": "identity-cli",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"identity-models",
				"identity-connector-entity-storage",
				"identity-service",
				"identity-rest-client",
				"identity-connector-iota",
				"identity-connector-universal",
				"identity-cli"
			]
		}
	]
}
