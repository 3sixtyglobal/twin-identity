{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"autorelease",
		"bech",
		"Bitstring",
		"cryptosuite",
		"devnet",
		"eddsa",
		"Faucet",
		"Multibase",
		"nameof",
		"openapi",
		"Stiftung",
		"unrevoke",
		"Unrevoking",
		"nanos"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/tst1.*/",
		"/^```(.|\\s)*?```\\s*$/gm"
	]
}
